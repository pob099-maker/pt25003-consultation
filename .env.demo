# The public demonstration build, and the way to run it locally:
#   npm run dev:demo
#
# Vite gives a mode file priority over .env.local, so these blanks override any
# real credentials a developer has sitting there. isDemoSite() refuses a backend
# on top of that. Without both, "testing the demo" means writing invented rows
# into the live consultation.
VITE_DEMO=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
