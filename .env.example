# Copy to .env.local and fill in from your Supabase project settings (API).
# Both values are safe to ship in a public bundle: the anon key only grants
# what the row-level security policies in supabase/migrations allow, which is
# "insert a consultation response" and nothing else.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the "Return to project home" button on the thank-you page goes.
VITE_HOME_URL=https://potatolink.com.au

# Shown on the privacy page as the contact for privacy questions, and as the
# contact for anybody who would rather give their input by phone than online.
VITE_PRIVACY_CONTACT_NAME=PotatoLink Project Team
VITE_PRIVACY_CONTACT_EMAIL=info@potatolink.com.au

# Optional. A phone number for people who would rather talk than fill in a form.
# Leave it blank and the offer is made by email only, rather than with no number
# behind it.
VITE_CONTACT_PHONE=
